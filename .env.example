# Copy to .env and edit.
ALLOW_SIGNUP=false

# LAN only, no tunnel yet: bind to all interfaces so other devices on the
# network can reach http://<host-ip>:3000. Leave COOKIE_SECURE off — this
# path is plain HTTP, and a Secure cookie would be dropped by the browser.
BIND=0.0.0.0
COOKIE_SECURE=false

# VPS with HTTPS (Caddy, --profile web): set these instead
# DOMAIN=learn.example.com
# COOKIE_SECURE=true
# BIND=127.0.0.1

# Cloudflare Tunnel (--profile tunnel): paste the token from the Cloudflare
# Zero Trust dashboard (Networks > Tunnels > your tunnel > Docker installer).
# Once the tunnel's public hostname is your only way in, also set:
#   BIND=127.0.0.1       # stop answering direct LAN requests, force the tunnel
#   COOKIE_SECURE=true   # the public hostname is always HTTPS
# CLOUDFLARE_TUNNEL_TOKEN=
